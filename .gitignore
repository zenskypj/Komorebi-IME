# Linux frontend build output
/linux/target/
/linux/bridge/lib/
/linux/bridge/include/
/linux/data/

# IDE
.idea/
*.iml
/mozc/src/main/assets/dictionaries/*
!/mozc/src/main/assets/dictionaries/proper-nouns.txt
