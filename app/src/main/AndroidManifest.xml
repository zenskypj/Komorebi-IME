<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used only when the user explicitly downloads the optional Karukan or zenz model. Conversion and
         typed text remain on-device; Mozc works without a network connection. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />

    <!--
      allowBackup is off deliberately. The profile directory holds mozc's conversion-learning
      history and both dictionaries; shipping that to a backup server would undo the point of an
      IME that never touches the network itself.
    -->
    <application
        android:name=".KomorebiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZinnaIme">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/beam_file_paths" />
        </provider>

        <activity
            android:name=".ime.ProofreadActivity"
            android:exported="false"
            android:label="AI 文章校正"
            android:theme="@style/Theme.ZinnaIme.Proofread" />
        <activity
            android:name=".ime.ProofreadModelActivity"
            android:exported="false"
            android:label="AI 文章校正モデル"
            android:parentActivityName=".settings.SettingsActivity" />
        <activity android:name=".settings.NfcMigrationActivity" android:exported="false" />
        <activity android:name=".settings.MeetsBeamActivity" android:exported="true" android:label="Meets Beam で送る">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <service android:name=".settings.MeetsBeamHostService" android:exported="true" android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter><action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" /></intent-filter>
            <meta-data android:name="android.nfc.cardemulation.host_apdu_service" android:resource="@xml/meets_beam_service" />
        </service>
        <service android:name=".settings.BeamAccessibilityService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:label="Meets Beam の URL 取得">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/beam_accessibility" />
        </service>
        <service android:name=".settings.NfcMigrationHostService" android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter><action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" /></intent-filter>
            <meta-data android:name="android.nfc.cardemulation.host_apdu_service" android:resource="@xml/nfc_migration_service" />
        </service>
        <service
            android:name=".ime.ZinnaImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <!--
                  This is InputMethod.SERVICE_INTERFACE, which is "android.view.InputMethod" —
                  NOT the interface's fully-qualified name (android.view.inputmethod.InputMethod).
                  Getting it wrong fails silently: the service still installs and still resolves by
                  its own action, but InputMethodManagerService never sees it, so the IME is simply
                  absent from `ime list` with nothing logged anywhere.
                -->
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name=".settings.EngineDictActivity"
            android:exported="false"
            android:label="変換エンジン・辞書"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.InputSettingsActivity"
            android:exported="false"
            android:label="入力方式"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.AppearanceActivity"
            android:exported="false"
            android:label="表示とサイズ"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.LearningActivity"
            android:exported="false"
            android:label="変換学習"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.AboutActivity"
            android:exported="false"
            android:label="Komorebi IME について"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.VisualLayoutEditorActivity"
            android:exported="false"
            android:label="視覚的な配列エディタ"
            android:parentActivityName=".settings.ThemeEditorActivity" />

        <activity
            android:name=".settings.ThemeEditorActivity"
            android:exported="false"
            android:label="きせかえ"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.AppProfileActivity"
            android:exported="false"
            android:label="アプリ別入力プロファイル"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.MeaningDictionaryActivity"
            android:exported="false"
            android:label="意味辞書"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.UserDictionaryActivity"
            android:exported="false"
            android:label="@string/user_dictionary"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.LegalActivity"
            android:exported="false"
            android:label="@string/open_source_licenses"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".settings.InputGuideActivity" android:exported="false" />
        <activity android:name=".settings.SnippetActivity" android:exported="false" />
    </application>
</manifest>
